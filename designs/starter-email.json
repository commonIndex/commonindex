{
  "title": "Starter · Transactional email",
  "description": "An order receipt and shipping update with itemized totals, delivery details, and linked tracking.",
  "template_kind": "layout",
  "surface": "email",
  "state": "approved",
  "cites": [],
  "spec": {
    "tokens": {
      "color.bg": {
        "$type": "color",
        "$value": "#fffdfa"
      },
      "color.surface": {
        "$type": "color",
        "$value": "#f3f6fa"
      },
      "color.text": {
        "$type": "color",
        "$value": "#172033"
      },
      "color.muted": {
        "$type": "color",
        "$value": "#64748b"
      },
      "color.accent": {
        "$type": "color",
        "$value": "#3159dc"
      },
      "color.onAccent": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "color.border": {
        "$type": "color",
        "$value": "#dde5ee"
      },
      "color.danger": {
        "$type": "color",
        "$value": "#c2413a"
      },
      "radius.md": {
        "$type": "dimension",
        "$value": 14
      },
      "font.size.body": {
        "$type": "dimension",
        "$value": 15
      },
      "font.size.heading": {
        "$type": "dimension",
        "$value": 28
      }
    },
    "screens": [
