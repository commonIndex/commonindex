                "h": 28,
                "cites": "color.text"
              },
              {
                "id": "step-three",
                "role": "body",
                "text": "Next: arriving at your door",
                "w": 472,
                "h": 28,
                "cites": "color.text",
                "tone": "muted"
              }
            ]
          },
          {
            "id": "shipment-address",
            "role": "body",
            "text": "Maya Ortiz · 1 Example Street, Example City",
            "x": 40,
            "y": 588,
            "w": 520,
            "h": 48,
            "cites": "color.text",
            "tone": "muted"
          },
          {
            "id": "receipt-link",
            "role": "button",
            "text": "View order details",
            "x": 40,
            "y": 666,
            "w": 520,
            "h": 52,
            "cites": "color.accent",
            "goto": "receipt",
            "tone": "accent"
          },
          {
            "id": "shipping-help",
            "role": "body",
            "text": "Need to change something? Reply to your receipt.",
            "x": 40,
            "y": 754,
            "w": 520,
            "h": 28,
            "cites": "color.text",
            "tone": "muted"
          }
        ]
