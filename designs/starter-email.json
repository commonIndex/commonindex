              {
                "id": "items-label",
                "role": "field-label",
                "text": "YOUR ORDER",
                "w": 472,
                "h": 18,
                "cites": "color.text"
              },
              {
                "id": "item-mugs",
                "role": "body",
                "text": "Stoneware mug × 2 — $48.00",
                "w": 472,
                "h": 32,
                "cites": "color.text"
              },
              {
                "id": "item-coffee",
                "role": "body",
                "text": "House blend coffee × 1 — $20.00",
                "w": 472,
                "h": 32,
                "cites": "color.text"
              }
            ]
          },
          {
            "id": "shipping",
            "role": "body",
            "text": "Standard shipping · Free",
            "x": 40,
            "y": 484,
            "w": 350,
            "h": 28,
            "cites": "color.text"
          },
          {
            "id": "total",
            "role": "heading",
            "text": "Total: $68.00",
            "x": 40,
            "y": 528,
            "w": 520,
            "h": 44,
            "cites": "font.size.heading"
          },
          {
            "id": "address",
            "role": "body",
            "text": "Delivering to Maya Ortiz · 1 Example Street, Example City",
            "x": 40,
            "y": 594,
            "w": 520,
            "h": 48,
            "cites": "color.text",
            "tone": "muted"
          },
          {
            "id": "tracking-link",
            "role": "button",
            "text": "Track your order →",
            "x": 40,
            "y": 668,
            "w": 520,
            "h": 52,
            "cites": "color.accent",
            "goto": "tracking",
            "tone": "accent"
          },
          {
            "id": "help",
            "role": "body",
            "text": "Questions? Reply to this email and we’ll help.",
            "x": 40,
            "y": 754,
            "w": 520,
            "h": 28,
            "cites": "color.text",
            "tone": "muted"
          }
        ]
      },
