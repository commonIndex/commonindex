        "id": "receipt",
        "name": "Order receipt",
        "w": 600,
        "h": 860,
        "elements": [
          {
            "id": "brand",
            "role": "logo",
            "text": "Example Co Goods",
            "x": 40,
            "y": 36,
            "w": 520,
            "h": 32,
            "cites": "color.accent"
          },
          {
            "id": "order-status",
            "role": "badge",
