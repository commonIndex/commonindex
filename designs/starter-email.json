            "y": 294,
            "w": 520,
            "h": 276,
            "cites": "color.border",
            "layout": "column",
            "gap": 10,
            "pad": 22,
            "children": [
              {
                "id": "eta-label",
                "role": "field-label",
                "text": "ESTIMATED DELIVERY",
                "w": 472,
                "h": 18,
                "cites": "color.text"
              },
              {
                "id": "eta",
                "role": "heading",
                "text": "Within 2–3 business days",
                "w": 472,
                "h": 76,
                "cites": "font.size.heading"
              },
              {
                "id": "step-one",
                "role": "body",
                "text": "✓ Order confirmed",
                "w": 472,
                "h": 28,
                "cites": "color.text"
              },
              {
                "id": "step-two",
                "role": "body",
                "text": "✓ Packed and handed to the carrier",
