            "id": "brand",
            "role": "logo",
            "text": "Example Co Goods",
            "x": 40,
            "y": 36,
            "w": 520,
            "h": 32,
            "cites": "color.accent"
          },
          {
            "id": "shipping-status",
            "role": "badge",
            "text": "ON ITS WAY",
            "x": 40,
            "y": 100,
            "w": 132,
            "h": 28,
            "cites": "color.accent"
          },
          {
            "id": "shipping-title",
