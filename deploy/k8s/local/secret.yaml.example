# Template only — copy to secret.yaml (gitignored) and fill in real values,
# or generate with:
#   kubectl create secret generic commonindex-secrets -n commonindex-local \
#     --from-literal=POSTGRES_PASSWORD=commonindex \
#     --from-literal=COMMONINDEX_DSN=postgresql://commonindex:commonindex@postgres:5432/commonindex_local \
#     --from-literal=COMMONINDEX_SECRET_KEY=$(make secret-key) \
#     --from-literal=GITHUB_TOKEN=ghp_xxx
#
# GITHUB_TOKEN is a PAT for v1 — a GitHub App is the
# upgrade once more than one org is connected. Never commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: commonindex-secrets
  namespace: commonindex-local
type: Opaque
stringData:
  POSTGRES_PASSWORD: "changeme"
  COMMONINDEX_DSN: "postgresql://commonindex:changeme@postgres:5432/commonindex_local"
  COMMONINDEX_SECRET_KEY: "changeme-fernet-key"
  GITHUB_TOKEN: "ghp_changeme"
