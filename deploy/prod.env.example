# CommonIndex — production settings for docker-compose.prod.yml.
# Copy to .env next to the compose file and fill in. Never commit the copy.

# ── required ─────────────────────────────────────────────────────────────
# The address people open, exactly as typed in a browser (https://…, no slash).
COMMONINDEX_PUBLIC_URL=https://commonindex.example.com
# The first admin. On first start the gateway log prints a one-time sign-in
# link for them:  docker compose -f docker-compose.prod.yml logs gateway
COMMONINDEX_ADMIN_EMAIL=admin@example.com
COMMONINDEX_ADMIN_NAME=
# Database password, and the key that encrypts warehouse credentials:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep COMMONINDEX_SECRET_KEY safe: lose it and stored warehouse passwords can't be read.
POSTGRES_PASSWORD=
COMMONINDEX_SECRET_KEY=

# ── the workspace ────────────────────────────────────────────────────────
COMMONINDEX_SPACE=main
COMMONINDEX_SPACE_NAME=Workspace
# Port on this machine; put TLS (a load balancer, Caddy, Traefik) in front.
HTTP_PORT=8080
BIND_ADDR=0.0.0.0

# ── sign-in (docs/sign-in.md) ────────────────────────────────────────────
# required: everyone signs in. (local trusts requests from this machine with no
# sign-in — never for a deployment.) How people sign in follows from what is set
# below: single sign-on, email links when SMTP is set, or one-time links an
# admin sends.
COMMONINDEX_SIGN_IN=required
# Email domains whose people may join on their own (comma separated).
COMMONINDEX_JOIN_DOMAINS=
# Single sign-on (OIDC): Okta, Microsoft Entra, Google Workspace…
COMMONINDEX_SSO_ISSUER=
COMMONINDEX_SSO_CLIENT_ID=
COMMONINDEX_SSO_CLIENT_SECRET=
COMMONINDEX_SSO_NAME=

# ── email: invites and sign-in links ─────────────────────────────────────
COMMONINDEX_SMTP_HOST=
COMMONINDEX_SMTP_PORT=587
COMMONINDEX_SMTP_USER=
COMMONINDEX_SMTP_PASSWORD=
COMMONINDEX_MAIL_FROM=CommonIndex <commonindex@example.com>
# 1 writes mail to the log instead of sending it — for trying it out only.
COMMONINDEX_MAIL_LOG=

# ── AI (docs/local-model.md) — any OpenAI-compatible endpoint ────────────
COMMONINDEX_LLM_BASE_URL=
COMMONINDEX_LLM_API_KEY=
COMMONINDEX_LLM_MODEL=
COMMONINDEX_LLM_TIMEOUT_SECONDS=420
COMMONINDEX_EMBED_BASE_URL=
COMMONINDEX_EMBED_API_KEY=
COMMONINDEX_EMBED_MODEL=
COMMONINDEX_MODEL_PROVIDER=
COMMONINDEX_MODEL_ID=
COMMONINDEX_MODEL_API_KEY=
COMMONINDEX_MODEL_BASE_URL=

# ── optional parts ───────────────────────────────────────────────────────
# Code search: run with  --profile code  and set this.
COMMONINDEX_ZOEKT_URL=
# COMMONINDEX_ZOEKT_URL=http://zoekt:6070
# Media storage: rendered videos and page snapshots. local keeps them in the
# media volume; s3 keeps them in a bucket — AWS S3, Google Cloud Storage, R2,
# MinIO (docs/deploy.md, Media storage). Use s3 to run more than one machine.
COMMONINDEX_MEDIA_STORE=local
# COMMONINDEX_MEDIA_STORE=s3
# COMMONINDEX_MEDIA_BUCKET=your-bucket
# COMMONINDEX_MEDIA_PREFIX=commonindex/
# COMMONINDEX_MEDIA_ENDPOINT=https://storage.googleapis.com   # not for AWS S3
# COMMONINDEX_MEDIA_REGION=us-east-1
# COMMONINDEX_MEDIA_ACCESS_KEY_ID=          # or an instance role / AWS_* variables
# COMMONINDEX_MEDIA_SECRET_ACCESS_KEY=
# Video rendering: builds Chromium and ffmpeg into the gateway (docs/videos.md).
GATEWAY_TARGET=tools
# GATEWAY_TARGET=video
